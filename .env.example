# ===== Server =====
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# ===== Mode Test =====
# true  = tidak publish ke Facebook (simulasi saja)
# false = publish nyata (aktifkan hanya setelah semua fase selesai)
TEST_MODE=true

# ===== CORS (koma-pisah, * untuk semua) =====
CORS_ORIGINS=*

# ===== Diisi mulai Fase 4+ =====
DATABASE_URL=
JWT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=